rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private app: only Michelle's own sign-ins can read or write anything.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['michellepon@weehur.com.sg', 'ponmichelle@gmail.com'];
    }
  }
}
